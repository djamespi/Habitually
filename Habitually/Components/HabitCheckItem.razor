@* HabitCheckItem.razor — A single habit row with custom checkbox, emoji, name,
   and streak indicator. Clicking the row toggles completion for today. *@

<div class="flex cursor-pointer items-center gap-gap-sm rounded-icon py-gap-xs transition-[background-color] duration-(--duration-fast) ease-[ease] hover:bg-[color-mix(in_srgb,var(--color-muted)_50%,transparent)] hover:px-gap-xs"
     style="--habit-color: @Habit.Color"
     @onclick="HandleClick">

    @* Custom checkbox: rounded square, fills with habit color when checked *@
    <div class="flex size-checkbox min-w-checkbox items-center justify-center rounded-icon border-2 transition-[background-color,border-color] duration-(--duration-fast) ease-[ease] @(IsCompleted ? "border-(--habit-color) bg-(--habit-color)" : "border-border") @(_animating ? "animate-checkbox-pop" : "")">
        @if (IsCompleted)
        {
            <svg class="block size-4" viewBox="0 0 16 16" fill="none">
                <polyline points="3.5 8 6.5 11 12.5 5"
                          stroke="white" stroke-width="2.5"
                          stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        }
    </div>

    @* Emoji and habit name *@
    <span class="w-6 shrink-0 text-center text-lg leading-none">@Habit.Emoji</span>
    <span class="flex-1 font-body text-sm font-medium @(IsCompleted ? "text-muted-foreground line-through" : "text-foreground")">@Habit.Name</span>

    @* Streak indicator on the right *@
    <span class="ml-auto text-sm leading-none">🔥</span>
    <span class="min-w-streak-count text-right font-numeric text-sm font-medium text-muted-foreground">@Streak</span>
</div>

@code {
    /// <summary>The habit model (name, emoji, color).</summary>
    [Parameter] public Habitually.Models.Habit Habit { get; set; } = default!;

    /// <summary>Whether this habit is completed today.</summary>
    [Parameter] public bool IsCompleted { get; set; }

    /// <summary>Current streak count for this habit.</summary>
    [Parameter] public int Streak { get; set; }

    /// <summary>Callback to toggle this habit's completion.</summary>
    [Parameter] public EventCallback OnToggle { get; set; }

    // Tracks whether the checkbox pop animation should play
    private bool _animating;

    /// <summary>Handle click: toggle completion and animate if checking on.</summary>
    private async Task HandleClick()
    {
        bool willCheck = !IsCompleted;

        // Tell the parent to toggle completion in HabitService
        await OnToggle.InvokeAsync();

        // Play the pop animation only when checking ON
        if (willCheck)
        {
            _animating = true;
            StateHasChanged();
            await Task.Delay(320);   // match the 0.32s animation duration
            _animating = false;
        }
    }
}
