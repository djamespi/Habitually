@* Sidebar.razor — Fixed left sidebar with logo, nav links, and footer tip card *@

<aside class="glass flex h-screen w-sidebar min-w-sidebar flex-col border-r border-border px-sidebar-px py-sidebar-py">
    @* ---- Logo area ---- *@
    <div class="flex items-center gap-gap-sm pb-sidebar-py">
        <div class="flex size-logo shrink-0 items-center justify-center rounded-logo bg-[linear-gradient(135deg,var(--color-primary),var(--color-gradient-partner))] font-display text-lg font-bold text-primary-foreground">H</div>
        <span class="font-display text-xl font-semibold tracking-tight text-foreground">Habitually</span>
    </div>

    @* ---- Navigation links ---- *@
    @* NavLink adds "active" automatically. The [&.active] utilities style it;
       group-[.active] applies the matching accent color to its icon. *@
    <nav class="flex flex-1 flex-col gap-gap-2xs">
        <div>
            <NavLink class="group relative flex h-sidebar-h cursor-pointer items-center gap-gap-xs rounded-button px-sidebar-item-px font-body text-sm font-medium text-muted-foreground no-underline [transition:var(--transition-nav)] [&:not(.active):hover]:bg-muted [&:not(.active):hover]:text-foreground [&:not(.active):hover]:[transform:translateX(2px)] [&.active]:border [&.active]:border-border [&.active]:bg-card [&.active]:text-foreground [&.active]:shadow-nav-active [&.active]:after:absolute [&.active]:after:left-0 [&.active]:after:top-[20%] [&.active]:after:h-[60%] [&.active]:after:w-heatmap-gap [&.active]:after:rounded-r-full [&.active]:after:bg-[linear-gradient(180deg,var(--color-primary),var(--color-gradient-partner))] [&.active]:after:content-['']" href="" Match="NavLinkMatch.All">
                <svg class="size-nav-icon shrink-0 group-[.active]:text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                <span>Dashboard</span>
            </NavLink>
        </div>

        <div>
            <NavLink class="group relative flex h-sidebar-h cursor-pointer items-center gap-gap-xs rounded-button px-sidebar-item-px font-body text-sm font-medium text-muted-foreground no-underline [transition:var(--transition-nav)] [&:not(.active):hover]:bg-muted [&:not(.active):hover]:text-foreground [&:not(.active):hover]:[transform:translateX(2px)] [&.active]:border [&.active]:border-border [&.active]:bg-card [&.active]:text-foreground [&.active]:shadow-nav-active [&.active]:after:absolute [&.active]:after:left-0 [&.active]:after:top-[20%] [&.active]:after:h-[60%] [&.active]:after:w-heatmap-gap [&.active]:after:rounded-r-full [&.active]:after:bg-[linear-gradient(180deg,var(--color-primary),var(--color-gradient-partner))] [&.active]:after:content-['']" href="habits" Match="NavLinkMatch.Prefix">
                <svg class="size-nav-icon shrink-0 group-[.active]:text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="8" y1="6" x2="21" y2="6"/>
                    <line x1="8" y1="12" x2="21" y2="12"/>
                    <line x1="8" y1="18" x2="21" y2="18"/>
                    <line x1="3" y1="6" x2="3.01" y2="6"/>
                    <line x1="3" y1="12" x2="3.01" y2="12"/>
                    <line x1="3" y1="18" x2="3.01" y2="18"/>
                </svg>
                <span>Habits</span>
            </NavLink>
        </div>

        <div>
            <NavLink class="group relative flex h-sidebar-h cursor-pointer items-center gap-gap-xs rounded-button px-sidebar-item-px font-body text-sm font-medium text-muted-foreground no-underline [transition:var(--transition-nav)] [&:not(.active):hover]:bg-muted [&:not(.active):hover]:text-foreground [&:not(.active):hover]:[transform:translateX(2px)] [&.active]:border [&.active]:border-border [&.active]:bg-card [&.active]:text-foreground [&.active]:shadow-nav-active [&.active]:after:absolute [&.active]:after:left-0 [&.active]:after:top-[20%] [&.active]:after:h-[60%] [&.active]:after:w-heatmap-gap [&.active]:after:rounded-r-full [&.active]:after:bg-[linear-gradient(180deg,var(--color-primary),var(--color-gradient-partner))] [&.active]:after:content-['']" href="insights" Match="NavLinkMatch.Prefix">
                <svg class="size-nav-icon shrink-0 group-[.active]:text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"/>
                    <line x1="12" y1="20" x2="12" y2="4"/>
                    <line x1="6" y1="20" x2="6" y2="14"/>
                </svg>
                <span>Insights</span>
            </NavLink>
        </div>

        <div>
            <NavLink class="group relative flex h-sidebar-h cursor-pointer items-center gap-gap-xs rounded-button px-sidebar-item-px font-body text-sm font-medium text-muted-foreground no-underline [transition:var(--transition-nav)] [&:not(.active):hover]:bg-muted [&:not(.active):hover]:text-foreground [&:not(.active):hover]:[transform:translateX(2px)] [&.active]:border [&.active]:border-border [&.active]:bg-card [&.active]:text-foreground [&.active]:shadow-nav-active [&.active]:after:absolute [&.active]:after:left-0 [&.active]:after:top-[20%] [&.active]:after:h-[60%] [&.active]:after:w-heatmap-gap [&.active]:after:rounded-r-full [&.active]:after:bg-[linear-gradient(180deg,var(--color-primary),var(--color-gradient-partner))] [&.active]:after:content-['']" href="settings" Match="NavLinkMatch.Prefix">
                <svg class="size-nav-icon shrink-0 group-[.active]:text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 8.6a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                </svg>
                <span>Settings</span>
            </NavLink>
        </div>
    </nav>

    @* ---- Footer tip card, pinned to the bottom ---- *@
    <div class="pt-gap-md">
        <div class="mx-auto w-sidebar-footer rounded-logo border border-border bg-[color-mix(in_srgb,var(--color-card)_50%,transparent)] p-card-sidebar font-numeric text-xs leading-[1.6] text-muted-foreground">
            <span class="font-semibold text-foreground">Tip.</span> Consistency over
            intensity — show up small, every day.
        </div>
    </div>
</aside>
